# --- Pubblico / build-time ---
NEXT_PUBLIC_SITE_URL=https://events.dbyoung.it
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/core829/dbyoung-events

# --- Convex ---
# Ottenuto con `npx convex login` + `npx convex dev` (poi `npx convex deploy`).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Sicurezza applicativa (server-only) ---
# Genera con: openssl rand -hex 32 (o node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SERVER_SECRET=
# sha256(SERVER_SECRET) — va impostato anche nelle env del deployment Convex:
#   npx convex env set SERVER_SECRET_HASH <valore>
SERVER_SECRET_HASH=
# Prima registrazione con questa email diventa il FOUNDER (Dimitri).
AUTH_FOUNDER_EMAIL=contact@dbyoung.it
# Lista IP abilitati al backoffice (server-side), separati da virgola. Vuoto = nessun filtro IP.
# Esempio: 203.0.113.4,198.51.100.7
BACKOFFICE_IP_ALLOWLIST=

# --- Stripe (pagamenti) ---
# Senza chiavi il flusso di prenotazione simula il pagamento in dev (stesso codice
# del webhook: booking pagato, ticket creati, email loggata) — comodo per i test.
STRIPE_SECRET_KEY=
# Secret del webhook (Stripe CLI: `stripe listen --forward-to localhost:3000/api/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=

# --- Resend (email con QR) ---
RESEND_API_KEY=
# Mittente verificato su Resend (dominio events.dbyoung.it)
RESEND_FROM=Eventi DBYoung <contact@dbyoung.it>
# Destinatario richieste preventivo (Calendly)
BOOKING_TO=contact@dbyoung.it
